{
  // "name" phải TRÙNG tên Worker trên Cloudflare (Workers & Pages → tên dự án)
  "name": "ktgs",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/proxy", "/baocao/proxy", "/baocao/login"]
  }
}
